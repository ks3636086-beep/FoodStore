<body>
    <form id="form1" runat="server">

        <!-- Start Main Top -->
        <div class="main-top">
            <div class="container-fluid">
                <div class="row">
                    <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12">
                        <div class="our-link d-flex justify-content-lg-end justify-content-start position-relative" style="z-index: 9999;">
                            <ul class="list-unstyled mb-0">
                                <li class="dropdown position-relative">
                                    <!-- Dropdown Trigger Button -->
                                    <a href="#"
                                        class="dropdown-toggle d-inline-flex align-items-center gap-2 text-decoration-none fw-semibold text-white px-3 py-1 rounded small"
                                        data-bs-toggle="dropdown"
                                        data-toggle="dropdown"
                                        aria-expanded="false">
                                        <i class="fa fa-user"></i>
                                        <span>MY ACCOUNT</span>
                                    </a>

                                    <!-- Dropdown Menu -->
                                    <div class="dropdown-menu dropdown-menu-end shadow-lg border-0 rounded-3 p-2 bg-white mt-1"
                                        style="min-width: 170px; z-index: 10000; position: absolute;">

                                        <a href="my-profile.aspx"
                                            runat="server"
                                            id="profilebtn"
                                            class="dropdown-item rounded-2 py-2 text-dark small d-flex align-items-center gap-2">
                                            <i class="fas fa-user-circle text-muted" style="width: 16px;"></i>
                                            <span>Profile</span>
                                        </a>

                                        <a href="my-order.aspx"
                                            runat="server"
                                            id="orderbtn"
                                            class="dropdown-item rounded-2 py-2 text-dark small d-flex align-items-center gap-2">
                                            <i class="fas fa-shopping-bag text-muted" style="width: 16px;"></i>
                                            <span>My Orders</span>
                                        </a>

                                        <a href="ecommerce_customer.aspx"
                                            runat="server"
                                            id="loginbtn"
                                            class="dropdown-item rounded-2 py-2 text-dark small d-flex align-items-center gap-2">
                                            <i class="fas fa-user-plus text-muted" style="width: 16px;"></i>
                                            <span>Sign Up</span>
                                        </a>

                                        <div class="dropdown-divider my-1 opacity-25"></div>

                                        <a href="logout.aspx"
                                            runat="server"
                                            id="logoutbtn"
                                            class="dropdown-item rounded-2 py-2 text-danger small d-flex align-items-center gap-2 fw-semibold">
                                            <i class="fas fa-sign-out-alt text-danger" style="width: 16px;"></i>
                                            <span>Logout</span>
                                        </a>

                                    </div>
                                </li>
                            </ul>
                        </div>
                    </div>

                    <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12">

                        <div class="text-slid-box">
                            <div id="offer-box" class="carouselTicker">
                                <ul class="offer-box">
                                    <li>
                                        <i class="fab fa-opencart"></i>20% off Entire Purchase Promo code: offT80
                              </li>
                                    <li>
                                        <i class="fab fa-opencart"></i>50% - 80% off on Vegetables
                              </li>
                                    <li>
                                        <i class="fab fa-opencart"></i>Off 10%! Shop Vegetables
                              </li>
                                    <li>
                                        <i class="fab fa-opencart"></i>Off 50%! Shop Now
                              </li>
                                    <li>
                                        <i class="fab fa-opencart"></i>Off 10%! Shop Vegetables
                              </li>
                                    <li>
                                        <i class="fab fa-opencart"></i>50% - 80% off on Vegetables
                              </li>
                                    <li>
                                        <i class="fab fa-opencart"></i>20% off Entire Purchase Promo code: offT30
                              </li>
                                    <li>
                                        <i class="fab fa-opencart"></i>Off 50%! Shop Now 
                              </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- End Main Top -->


        <!-- Start Main Top -->
        <header class="main-header">
            <!-- Start Navigation -->
            <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm py-2 sticky-top">
                <div class="container-fluid px-4">

                    <!-- 1. Logo (Left Side) -->
                    <a class="navbar-brand me-2" href="index.aspx">
                        <img src="images/FoodStore_logo.png" alt="Food Store" style="height: 50px; width: auto;">
                    </a>

                    <!-- Mobile Toggler -->
                    <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <!-- Navbar Content -->
                    <div class="collapse navbar-collapse" id="navbarContent">

                        <!-- 2. Search Bar (Full Available Space Leega) -->
                        <div class="flex-grow-1 mx-lg-4 my-2 my-lg-0">
                            <div class="input-group w-100">
                                <input class="form-control bg-light border-end-0 rounded-start-pill ps-3" type="search" placeholder="Search fresh groceries..." aria-label="Search">
                                <button class="btn btn-success rounded-end-pill px-3" type="submit">
                                    <i class="fa fa-search"></i>
                                </button>
                            </div>
                        </div>

                        <!-- 3. Navigation Links & Cart (Right Side) -->
                        <ul class="navbar-nav ms-auto align-items-lg-center gap-1">
                            <li class="nav-item">
                                <a class="nav-link text-dark active fw-semibold px-2" href="index.aspx">Home</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-secondary fw-semibold px-2" href="about.aspx">About Us</a>
                            </li>

                            <li class="nav-item dropdown dropdown-hover">
                                <a class="nav-link dropdown-toggle text-secondary fw-semibold px-2" href="shop.aspx" id="shopDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">Shop
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end border-0 shadow-lg mt-0 rounded-3" aria-labelledby="shopDropdown">
                                    <li><a class="dropdown-item py-2" href="shop.aspx">Sidebar Shop</a></li>
                                    <li>
                                        <hr class="dropdown-divider">
                                    </li>
                                    <li><a class="dropdown-item py-2" href="cart.aspx">Cart</a></li>
                                    <li><a class="dropdown-item py-2" href="checkout.aspx">Checkout</a></li>
                                    <li><a class="dropdown-item py-2" href="my-account.aspx">My Account</a></li>
                                    <li><a class="dropdown-item py-2" href="wishlist.aspx">Wishlist</a></li>
                                </ul>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-secondary fw-semibold px-2" href="contact-us.aspx">Contact Us</a>
                            </li>

                            <!-- Cart Button -->
                            <li class="nav-item ms-lg-2 mt-2 mt-lg-0">
                                <a href="cart.aspx" class="btn btn-outline-success position-relative rounded-pill px-3 py-1 d-inline-flex align-items-center gap-2">
                                    <i class="fa fa-shopping-bag"></i>
                                    <span class="fw-bold">Cart</span>
                                    <span runat="server" id="cart_count1" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">0
                                    </span>
                                </a>
                            </li>
                        </ul>

                    </div>
                </div>
            </nav>
            <!-- End Navigation -->
        </header>
        <!-- End Main Top -->


        <div>
            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
            </asp:ContentPlaceHolder>
        </div>
